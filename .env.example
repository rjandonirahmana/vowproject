# ── Wajib ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://USER:SANDI@localhost:5432/undangan
# Default false = migrasi manual (psql -f migration/NNN.sql). true = otomatis saat start;
# migrasi yang objeknya sudah ada dilewati & hanya dicatat.
AUTO_MIGRATE=false

# ── Opsional ──────────────────────────────────────────────────────────────
# Default: site-addr di Cargo.toml (0.0.0.0:3600). Di container 0.0.0.0:3000.
# SITE_ADDR=0.0.0.0:3600
# WA admin untuk tombol "Konfirmasi Pembayaran" setelah pemesanan.
ADMIN_WHATSAPP=0812xxxxxxxx
# Sandi panel /admin (kelola tema & aktivasi pesanan). Kosong = panel mati.
# Pakai string acak panjang, mis. `openssl rand -hex 24`.
ADMIN_TOKEN=
# Pesanan yang belum dikonfirmasi admin dihapus otomatis (DB + foto/lagu di
# RustFS) setelah sekian jam. Bawaan 24.
UNPAID_TTL_HOURS=24

# RustFS (foto mempelai & lagu upload). ACCESS_KEY kosong = unggahan dilewati.
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_BUCKET=undangan
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_PUBLIC_URL=https://image.ulalaapi.store

RUST_LOG=undangan=info,tower_http=info
# true = bucket yang belum ada dibuat saat start + policy baca publik (bawaan false)
RUSTFS_AUTO_CREATE_BUCKET=false

# ── WhatsApp lewat waxum (https://github.com/imtaqin/waxum) ──
# Dipakai untuk: bukti transfer → admin, tautan Kelola & "undangan aktif" →
# pemesan, kunci story → tamu. Kosong = semua WA dimatikan.
# Dari dalam container: host = 172.17.0.1 (port bawaan waxum 3451).
WAXUM_BASE_URL=
# ID sesi waxum yang sudah dipasangkan (QR / kode) di konsol waxum.
WAXUM_SESSION=undangan
# SUPERADMIN_TOKEN waxum, atau token ber-scope sesi dari POST /api/v1/tokens.
WAXUM_TOKEN=
# Penerima notifikasi bukti transfer (bawaan 089635816942).
PAYMENT_NOTIFY_WA=6289635816942
# Alamat publik untuk tautan di pesan WA (bawaan https://ilyvowcraft.online).
SITE_URL=https://ilyvowcraft.online
